{"ts":1782061127,"hash":"1ec40480b461d5caa28286f83c748e1f9f617439126c37e4a530ec871683de87","mode":"diff","ops":[{"tag":"replace","a1":3,"a2":8,"text":"\t\"bufio\"\n\t\"fmt\"\n\t\"os\"\n\t\"strconv\"\n\t\"strings\"\n"},{"tag":"insert","a1":10,"a2":10,"text":"type Coordenada struct {\n\tlinha, coluna int\n}\n\n"},{"tag":"replace","a1":11,"a2":16,"text":"\tif len(matriz) == 0 || len(matriz[0]) == 0 {\n\t\treturn 0\n\t}\n"},{"tag":"replace","a1":17,"a2":36,"text":"\tlinhas := len(matriz)\n\tcolunas := len(matriz[0])\n"},{"tag":"replace","a1":37,"a2":40,"text":"\tvar fila []Coordenada\n\tfrescas := 0\n"},{"tag":"replace","a1":41,"a2":48,"text":"\tfor l := 0; l < linhas; l++ {\n\t\tfor c := 0; c < colunas; c++ {\n\t\t\tif matriz[l][c] == 2 {\n\t\t\t\tfila = append(fila, Coordenada{linha: l, coluna: c})\n\t\t\t} else if matriz[l][c] == 1 {\n\t\t\t\tfrescas++\n\t\t\t}\n\t\t}\n\t}\n"},{"tag":"replace","a1":49,"a2":51,"text":"\tif frescas == 0 {\n\t\treturn 0\n\t}\n"},{"tag":"replace","a1":52,"a2":59,"text":"\tminutos := 0\n\tdirecoes := []Coordenada{\n\t\t{-1, 0},\n\t\t{1, 0},\n\t\t{0, -1},\n\t\t{0, 1},\n\t}\n"},{"tag":"replace","a1":60,"a2":61,"text":"\tfor len(fila) > 0 && frescas > 0 {\n\t\tminutos++\n\t\ttamanhoNivel := len(fila)\n\n\t\tfor i := 0; i < tamanhoNivel; i++ {\n\t\t\tatual := fila[0]\n\t\t\tfila = fila[1:]\n\n\t\t\tfor _, d := range direcoes {\n\t\t\t\tnl := atual.linha + d.linha\n\t\t\t\tnc := atual.coluna + d.coluna\n\n\t\t\t\tif nl >= 0 && nl < linhas && nc >= 0 && nc < colunas && matriz[nl][nc] == 1 {\n\t\t\t\t\tmatriz[nl][nc] = 2\n\t\t\t\t\tfrescas--\n\t\t\t\t\tfila = append(fila, Coordenada{linha: nl, coluna: nc})\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tif frescas > 0 {\n\t\treturn -1\n\t}\n\n\treturn minutos\n"},{"tag":"replace","a1":62,"a2":63,"text":"\n"},{"tag":"replace","a1":64,"a2":68,"text":"\tscanner := bufio.NewScanner(os.Stdin)\n\tif !scanner.Scan() {\n\t\treturn\n\t}\n"},{"tag":"replace","a1":69,"a2":72,"text":"\tpartes := strings.Fields(scanner.Text())\n\tnl, _ := strconv.Atoi(partes[0])\n\tnc, _ := strconv.Atoi(partes[1])\n"},{"tag":"replace","a1":73,"a2":83,"text":"\tmatriz := make([][]int, nl)\n\tfor i := 0; i < nl; i++ {\n\t\tscanner.Scan()\n\t\tlinhaStr := strings.Fields(scanner.Text())\n\t\tlinha := make([]int, nc)\n\t\tfor j := 0; j < nc; j++ {\n\t\t\tlinha[j], _ = strconv.Atoi(linhaStr[j])\n\t\t}\n\t\tmatriz[i] = linha\n\t}\n"},{"tag":"replace","a1":84,"a2":86,"text":"\tfmt.Println(resolver(matriz))\n"}]}
